{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",

// Configure how the logo appears
  "logo": {
    "source": "~/.config/fastfetch/art.png",
    "type": "auto",		// Logo type: file(txt), auto, kitty, kitty-direct
    "recache": true,
    "width": 30,
    "height": 12,
    "padding": {
      "top": 0,          
      "left": 0,         
      "right": 2   
    },
    "color": {             // Override logo colors
        "1": "blue",
        "2": "white"
    }

// Control how information is displayed
  },
  "display": {
      "separator": "",     // Separator between keys and values
      "color": {
          "keys": "white",    // Key color
          "title": "green"     // Title color
      },
      "key": {
          "width": 16,       // Aligns keys to this width
          "type": "string"   // string, icon, both, or none
      },
      "bar": {
          "width": 10,       // Width of percentage bars
          "char": {
              "elapsed": "■", // Character for elapsed portion
              "total": "-",    // Character for total portion
          },
      },
      "percent": {
          "type": 9,         // 1=number, 2=bar, 3=both, 9=colored number
          "color": {
              "green": "green",
              "yellow": "light_yellow",
              "red": "light_red"
          }
      }
  },


// Specify which modules to display and their configuration
  "modules": [
    "title",
    "separator",
    "os",
    "kernel",
    {
      "type": "wm",
      "key": "WinManager"
    },
    {
              "type": "display",
              "key": "Display",
              "format": "{1}x{2} @ {3}Hz"
            },
    "uptime",
    {
      "type": "command",
      "key": "OS Age",
      "text": "birth=$(stat -c %W /); current=$(date +%s); diff=$((current - birth)); echo $((diff / 86400)) days"
    },
    "terminal",
    {
      "type": "cpu",
      "format": "{1} @{7} GHz"
    },
    {
      "type": "gpu",
      "format": "{1} {2}"
    },
    {
    	"type": "memory",
    	"key": "Ram",
    },
    {
          "type": "disk",
          "key": "Disk",
          "folders": "/",
          "format": "{1} / {2} ({3})"
        },
    "break",
  ]
}




